# Copier vers .env en local (ne jamais committer le vrai .env)
SECRET_KEY=changez-moi-en-local
OPENAI_API_KEY=
FLASK_ENV=production
# Analyse plante : 0 = structure seule, photo enregistrée en attente (défaut V1).
# Passer à 1 à la fin du projet (avec OPENAI_API_KEY) pour brancher le service.
PLANT_ANALYSIS_ENABLED=0
