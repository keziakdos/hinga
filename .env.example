# Copier vers .env en local (ne jamais committer le vrai .env)
SECRET_KEY=changez-moi-en-local
OPENAI_API_KEY=
FLASK_ENV=production
# Analyse plante : 0 = structure seule, photo enregistrée en attente (défaut V1).
# Passer à 1 à la fin du projet pour brancher le service.
PLANT_ANALYSIS_ENABLED=0
# Fournisseur : gemini (quota gratuit, recommandé) ou openai (payant, repli).
PLANT_ANALYSIS_PROVIDER=gemini
# Clé gratuite : https://aistudio.google.com/apikey (ne jamais committer)
GEMINI_API_KEY=
